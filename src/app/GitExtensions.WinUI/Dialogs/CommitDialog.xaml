<ContentDialog
    x:Class="GitExtensions.WinUI.Dialogs.CommitDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitExtensions.WinUI"
    Title="Commit"
    PrimaryButtonText="Commit"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid RowDefinitions="Auto,220,Auto,Auto,Auto" Width="640" RowSpacing="8">

        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.75" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Staged" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListView Grid.Row="1" x:Name="StagedList"
                          ItemsSource="{x:Bind ViewModel.Staged}"
                          SelectionMode="Extended"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChangedFileViewModel">
                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <Button Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Unstage selected"
                        Click="Unstage_Click" />
                <Button Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" ToolTipService.ToolTip="Stage selected"
                        Click="Stage_Click" />
            </StackPanel>

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Text="Not staged" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListView Grid.Row="1" x:Name="UnstagedList"
                          ItemsSource="{x:Bind ViewModel.Unstaged}"
                          SelectionMode="Extended"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChangedFileViewModel">
                            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <TextBox Grid.Row="2" x:Name="MessageBox"
                 PlaceholderText="Commit message"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="110" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
            <CheckBox x:Name="AmendCheck" Content="Amend last commit" Checked="Amend_Changed" Unchecked="Amend_Changed" />
            <CheckBox x:Name="SignOffCheck" Content="Sign off" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
