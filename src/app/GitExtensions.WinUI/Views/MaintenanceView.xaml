<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <ScrollViewer>
        <StackPanel Padding="20,16,20,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Maintenance" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Housekeeping for this repository."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Clean -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Remove untracked files" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                               Text="Deletes files git is not tracking. There is no reflog for this — preview first, and read the list." />

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="CleanDirectories" Content="Include folders" IsChecked="True" />
                        <CheckBox x:Name="CleanIgnored" Content="Include ignored files" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Preview what would be removed" Click="CleanPreview_Click" />
                        <Button Content="Remove them" Click="Clean_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Garbage collection -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Compact the repository" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                               Text="Repacks loose objects and prunes ones nothing references. Safe: anything still reachable, including from the reflog, is kept." />
                    <Button Content="Run garbage collection" Click="CollectGarbage_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Archive -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Export a snapshot" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                               Text="Writes the tree of a revision to an archive, without any git history in it." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="ArchiveReference" Header="Revision" Text="HEAD" Width="220" />
                        <Button Content="Choose file and export…" Click="Archive_Click"
                                VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</views:RepositoryPage>
