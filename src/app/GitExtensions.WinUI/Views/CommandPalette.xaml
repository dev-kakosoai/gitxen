<ContentDialog
    x:Class="GitExtensions.WinUI.Views.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitExtensions.WinUI.Models"
    CloseButtonText="Close"
    DefaultButton="None">

    <Grid RowDefinitions="Auto,*" Width="620" Height="440" RowSpacing="10">

        <TextBox x:Name="QueryBox"
                 PlaceholderText="Type a command, page or branch"
                 TextChanged="QueryBox_TextChanged"
                 KeyDown="QueryBox_KeyDown" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <!-- One-time, refreshed by the Bindings.Update() in Filter: the palette re-evaluates
                     its bindings itself after each keystroke, so there is nothing to notify from. -->
                <TextBlock Text="No matching command" Style="{StaticResource EmptyStateBodyStyle}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind EmptyVisibility}" />

                <ListView x:Name="ResultList" ItemsSource="{x:Bind Results, Mode=OneWay}"
                          SelectionMode="Single" Padding="4"
                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                          ItemClick="ResultList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PaletteCommand">
                            <!-- Fixed widths rather than a star column: a column after one is
                                 arranged off the screen here. -->
                            <Grid ColumnDefinitions="110,330,Auto" ColumnSpacing="12">
                                <TextBlock Text="{x:Bind Category}"
                                           Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeCaption}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Detail}"
                                           Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeCaption}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
