<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.BranchesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GitExtensions.WinUI.Converters"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <Grid RowDefinitions="Auto,*,Auto,*" Padding="20,16,20,16">

        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Branches" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}">
                    <Run Text="{x:Bind Tab.BranchDetails.Count, Mode=OneWay}" />
                    <Run Text="local branches. Double-click one to check it out." />
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="NewBranch_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="New branch" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
            <ListView x:Name="BranchList" ItemsSource="{x:Bind Tab.BranchDetails, Mode=OneWay}"
                      SelectionMode="Single" Padding="4"
                      DoubleTapped="BranchList_DoubleTapped"
                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BranchInfo">
                        <!-- Fixed widths rather than a star column: a column placed after a star-sized
                             one is arranged off the right of the screen here. -->
                        <Grid ColumnDefinitions="440,220,90,100" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Check out" Click="Checkout_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AB;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Merge into current branch" Click="Merge_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
                                    <MenuFlyoutItem Text="Set upstream…" Click="SetUpstream_Click" />
                                    <MenuFlyoutItem Text="Copy name" Click="CopyName_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete…" Click="Delete_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          ToolTipService.ToolTip="Checked out"
                                          Visibility="{x:Bind conv:Show.If(IsCurrent)}" />
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subject}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Upstream}" Style="{StaticResource SecondaryTextStyle}"
                                           FontSize="12"
                                           Visibility="{x:Bind conv:Show.If(HasUpstream)}" />
                                <TextBlock Text="no upstream" Style="{StaticResource SecondaryTextStyle}"
                                           FontSize="12" FontStyle="Italic" Opacity="0.6"
                                           Visibility="{x:Bind conv:Show.IfNot(HasUpstream)}" />
                                <Border Style="{StaticResource RefBadgeStyle}"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        ToolTipService.ToolTip="Commits the upstream does not have"
                                        Visibility="{x:Bind conv:Show.If(IsAhead)}">
                                    <TextBlock FontSize="11">
                                        <Run Text="&#x2191;" /><Run Text="{x:Bind Ahead}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource RefBadgeStyle}"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        ToolTipService.ToolTip="Commits on the upstream that this branch does not have"
                                        Visibility="{x:Bind conv:Show.If(IsBehind)}">
                                    <TextBlock FontSize="11">
                                        <Run Text="&#x2193;" /><Run Text="{x:Bind Behind}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind ShortHash}"
                                       Style="{StaticResource HashTextStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Date}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="2,20,0,0">
            <TextBlock Text="Remote branches" Style="{StaticResource SectionCaptionStyle}"
                       VerticalAlignment="Center" />
            <InfoBadge Value="{x:Bind Tab.RemoteBranches.Count, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource CardBorderStyle}">
            <ListView ItemsSource="{x:Bind Tab.RemoteBranches, Mode=OneWay}" SelectionMode="Single" Padding="4"
                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RemoteBranchInfo">
                        <!-- Fixed widths rather than a star column: see the local branch rows above. -->
                        <Grid ColumnDefinitions="440,220,90,100" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Check out as a local branch…" Click="CheckoutRemote_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8AB;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Merge into current branch" Click="MergeRemote_Click" />
                                    <MenuFlyoutItem Text="Copy name" Click="CopyRemoteName_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete on the remote…" Click="DeleteRemote_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FullName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subject}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Remote}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ShortHash}"
                                       Style="{StaticResource HashTextStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Date}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</views:RepositoryPage>
