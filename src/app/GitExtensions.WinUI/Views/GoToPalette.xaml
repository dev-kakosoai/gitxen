<ContentDialog
    x:Class="GitExtensions.WinUI.Views.GoToPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitExtensions.WinUI.Models"
    CloseButtonText="Close"
    DefaultButton="None">

    <Grid RowDefinitions="Auto,*" Width="620" Height="440" RowSpacing="10">

        <TextBox x:Name="QueryBox"
                 PlaceholderText="Branch, tag, commit, stash, file or page — fw finds feat/winui"
                 TextChanged="QueryBox_TextChanged"
                 KeyDown="QueryBox_KeyDown" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <!-- One-time, refreshed by the Bindings.Update() in Filter: see CommandPalette. -->
                <TextBlock Text="Nothing matches" Style="{StaticResource EmptyStateBodyStyle}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind EmptyVisibility}" />

                <ListView x:Name="ResultList" ItemsSource="{x:Bind Results, Mode=OneWay}"
                          SelectionMode="Single" Padding="4"
                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                          ItemClick="ResultList_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GoToItem">
                            <!-- Fixed widths rather than a star column: a column after one is
                                 arranged off the screen here. Icon first, like every IDE's go-to
                                 popup: the kind is read before the name. -->
                            <Grid ColumnDefinitions="20,286,90,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="{StaticResource IconSizeSmall}"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          ToolTipService.ToolTip="{x:Bind Category}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Category}"
                                           Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeCaption}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Detail}"
                                           Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeCaption}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
