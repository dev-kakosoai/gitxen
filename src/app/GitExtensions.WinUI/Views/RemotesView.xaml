<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.RemotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GitExtensions.WinUI.Converters"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,16">

        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Remotes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Where this repository fetches from and pushes to."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="AddRemote_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                        <TextBlock Text="Add remote" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- No remotes at all is normal for a local-only repository, so it gets a real empty state. -->
        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:Show.IfNone(Tab.Remotes.Count), Mode=OneWay}">
            <FontIcon Glyph="&#xE968;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="No remotes" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                       Text="This repository is local only. Add a remote to fetch and push." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0"
                Visibility="{x:Bind conv:Show.IfAny(Tab.Remotes.Count), Mode=OneWay}">
            <ListView ItemsSource="{x:Bind Tab.Remotes, Mode=OneWay}" SelectionMode="Single" Padding="4"
                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <!-- Rows animate in as the listing refreshes; supported inline only,
                     a Transitions-typed style setter fails XAML parsing at runtime. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:RemoteInfo">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="4">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Fetch" Click="Fetch_Click" />
                                    <MenuFlyoutItem Text="Fetch and prune" Click="FetchPrune_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Copy URL" Click="CopyUrl_Click" />
                                    <MenuFlyoutItem Text="Remove…" Click="Remove_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <FontIcon Glyph="&#xE968;" FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind FetchUrl}" Style="{StaticResource CodeTextStyle}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource CodeTextStyle}" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind conv:Show.If(HasSeparatePushUrl)}">
                                    <Run Text="push:" /><Run Text="{x:Bind PushUrl}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</views:RepositoryPage>
