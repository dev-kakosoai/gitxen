<UserControl
    x:Class="GitExtensions.WinUI.Views.RepositoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitExtensions.WinUI.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <NavigationView x:Name="Navigation"
                    PaneDisplayMode="{x:Bind Tab.PaneDisplayMode, Mode=OneWay}"
                    IsPaneOpen="{x:Bind Tab.IsPaneOpen, Mode=OneWay}"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    OpenPaneLength="196"
                    SelectionChanged="Navigation_SelectionChanged">

        <!-- Which repository, which branch, and how far it has diverged. -->
        <NavigationView.PaneHeader>
            <StackPanel Margin="4,4,12,10" Spacing="4">
                <TextBlock Text="{x:Bind Tab.Title, Mode=OneWay}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Tab.WorkingDir, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Tab.BranchHeader, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeBody}" />
                    <Border Style="{StaticResource RefBadgeStyle}"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            Visibility="{x:Bind Tab.AheadVisibility, Mode=OneWay}">
                        <TextBlock FontSize="{StaticResource FontSizeCaption}">
                            <Run Text="&#x2191;" /><Run Text="{x:Bind Tab.AheadCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource RefBadgeStyle}"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{x:Bind Tab.BehindVisibility, Mode=OneWay}">
                        <TextBlock FontSize="{StaticResource FontSizeCaption}">
                            <Run Text="&#x2193;" /><Run Text="{x:Bind Tab.BehindCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Tag="changes" Content="Changes" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Value="{x:Bind Tab.PendingCount, Mode=OneWay}"
                               Visibility="{x:Bind Tab.PendingVisibility, Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem Tag="conflicts" Content="Conflicts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7BA;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Value="{x:Bind Tab.ConflictCount, Mode=OneWay}"
                               Visibility="{x:Bind Tab.ConflictVisibility, Mode=OneWay}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem Tag="history" Content="History">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="reflog" Content="Reflog">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7A7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem Tag="branches" Content="Branches">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8AB;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="remotes" Content="Remotes">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE968;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="tags" Content="Tags">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="stashes" Content="Stashes">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7B8;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="submodules" Content="Submodules">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="worktrees" Content="Worktrees">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F4;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Tag="gitconfig" Content="Git config">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9F5;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="maintenance" Content="Maintenance">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE90F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Tag="settings" Content="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <!--
            The sections are all instantiated and switched by visibility rather than navigated to in a
            Frame: a Frame recreates its page every time, which would throw away the commit list's
            scroll position and a half-typed commit message on every trip through the pane.

            The command bar is part of the content rather than NavigationView.Header so it shares the
            pages' left margin and scrolls with nothing — the header area adds its own padding that does
            not line up with the section titles underneath it.
        -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
            <!--
                Every action sits in one left-aligned run rather than being split across a star column
                to the window's right edge: content placed at the far right of this bar does not paint,
                and grouping the operations together reads better than stranding one of them opposite
                the rest.
            -->
            <Grid Grid.Row="0" Padding="20,8,20,8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            HorizontalAlignment="Left">

                    <!-- Switching branch is the most frequent thing anyone does, so it leads the bar
                         and carries the divergence counts rather than hiding them on a page. -->
                    <DropDownButton x:Name="BranchButton" ToolTipService.ToolTip="Switch branch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="{x:Bind Tab.BranchHeader, Mode=OneWay}" />
                            <Border Style="{StaticResource RefBadgeStyle}"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    Visibility="{x:Bind Tab.AheadVisibility, Mode=OneWay}">
                                <TextBlock FontSize="{StaticResource FontSizeCaption}">
                                    <Run Text="&#x2191;" /><Run Text="{x:Bind Tab.AheadCount, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource RefBadgeStyle}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{x:Bind Tab.BehindVisibility, Mode=OneWay}">
                                <TextBlock FontSize="{StaticResource FontSizeCaption}">
                                    <Run Text="&#x2193;" /><Run Text="{x:Bind Tab.BehindCount, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="BranchFlyout" Placement="Bottom" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <AppBarSeparator />

                    <Button Click="Fetch_Click" AutomationProperties.Name="Fetch" ToolTipService.ToolTip="Fetch from the remote">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Fetch" />
                        </StackPanel>
                    </Button>
                    <Button Click="Pull_Click" ToolTipService.ToolTip="Fetch and merge">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74B;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Pull" />
                        </StackPanel>
                    </Button>
                    <Button Click="Push_Click" ToolTipService.ToolTip="Push this branch to its remote">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Push" />
                        </StackPanel>
                    </Button>
                    <Button Click="Refresh_Click" ToolTipService.ToolTip="Reload this repository (Ctrl+R)">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                    </Button>


                    <!-- Only present when a remote resolves to something browsable, so a local-only
                         repository is not offered links that go nowhere. -->
                    <DropDownButton ToolTipService.ToolTip="Open this repository on its host"
                                    Visibility="{x:Bind Tab.HostVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="{x:Bind Tab.HostName, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Open repository" Click="HostRepository_Click" />
                                <MenuFlyoutItem Text="Open this branch" Click="HostBranch_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Create pull request from this branch"
                                                Click="HostCreatePullRequest_Click" />
                                <MenuFlyoutItem Text="Pull requests" Click="HostPullRequests_Click" />
                                <MenuFlyoutItem Text="Issues" Click="HostIssues_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Populated from what is actually installed; see ExternalTools. -->
                    <DropDownButton ToolTipService.ToolTip="Open this repository in another application">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A7;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Open in" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ExternalToolsFlyout" Placement="Bottom" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Click="Palette_Click" ToolTipService.ToolTip="Command palette (Ctrl+Shift+P)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="Commands" />
                        </StackPanel>
                    </Button>

                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                  IsActive="{x:Bind Tab.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--
                A paused operation is otherwise invisible: a rebase stopped on a conflict looks much
                like an ordinary dirty working directory. The actions are here rather than in a menu
                because this is the only thing worth doing while the repository is in this state.
            -->
            <InfoBar Grid.Row="1" Margin="20,0,20,8" IsOpen="{x:Bind Tab.HasOperation, Mode=OneWay}"
                     IsClosable="False" Severity="Warning"
                     Title="{x:Bind Tab.Operation.Title, Mode=OneWay}"
                     Message="{x:Bind Tab.Operation.Message, Mode=OneWay}">
                <!-- The actions go in the content: ActionButton takes a single ButtonBase, and this
                     state needs several. -->
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,12">
                        <Button Content="Continue" Click="OperationContinue_Click"
                                Visibility="{x:Bind Tab.Operation.ContinueVisibility, Mode=OneWay}" />
                        <Button Content="Skip this commit" Click="OperationSkip_Click"
                                Visibility="{x:Bind Tab.Operation.SkipVisibility, Mode=OneWay}" />
                        <Button Content="Abort" Click="OperationAbort_Click" />
                        <Button Content="Show conflicts" Click="ShowConflicts_Click" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- Committing fails without an identity, and git's own error does not say where to set it. -->
            <InfoBar Grid.Row="2" Margin="20,0,20,8" IsOpen="{x:Bind Tab.NeedsIdentity, Mode=OneWay}"
                     IsClosable="False" Severity="Warning"
                     Title="No commit identity configured"
                     Message="Set your name and email before committing, or git will refuse.">
                <InfoBar.ActionButton>
                    <Button Content="Open Git config" Click="OpenGitConfig_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Grid.Row="3" Margin="20,0,20,8"
                     IsOpen="{x:Bind Tab.IsResultOpen, Mode=TwoWay}"
                     Severity="{x:Bind Tab.ResultSeverity, Mode=OneWay}"
                     Title="{x:Bind Tab.ResultTitle, Mode=OneWay}">
                <InfoBar.Content>
                    <ScrollViewer MaxHeight="140" Margin="0,0,0,12"
                                  HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{x:Bind Tab.ResultMessage, Mode=OneWay}"
                                   Style="{StaticResource CodeTextStyle}"
                                   IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </InfoBar.Content>
            </InfoBar>

            <Grid Grid.Row="4">
                <views:ChangesView x:Name="ChangesPage" Tab="{x:Bind Tab, Mode=OneWay}" />
                <views:ConflictsView x:Name="ConflictsPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:HistoryView x:Name="HistoryPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:ReflogView x:Name="ReflogPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:BranchesView x:Name="BranchesPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:RemotesView x:Name="RemotesPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:TagsView x:Name="TagsPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:StashesView x:Name="StashesPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:SubmodulesView x:Name="SubmodulesPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:WorktreesView x:Name="WorktreesPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:GitConfigView x:Name="GitConfigPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:MaintenanceView x:Name="MaintenancePage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
                <views:SettingsView x:Name="SettingsPage" Tab="{x:Bind Tab, Mode=OneWay}" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </NavigationView>
</UserControl>
