<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitExtensions.WinUI"
    xmlns:controls="using:GitExtensions.WinUI.Controls"
    xmlns:graph="using:GitExtensions.WinUI.Graph"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Scope, filter and search, in one left-aligned run: see DiffPanel for why nothing is
             pinned to the far right of a full-width bar. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="16,12,16,10"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind Tab.ChromeVisibility, Mode=OneWay}">

            <!-- Which refs git walks. The default is the current branch; All branches is what makes
                 the lanes show anything other than a straight line. -->
            <SelectorBar x:Name="ScopeBar" SelectionChanged="ScopeBar_SelectionChanged"
                         VerticalAlignment="Center">
                <SelectorBarItem x:Name="CurrentBranchScope" Text="Current branch" IsSelected="True" />
                <SelectorBarItem x:Name="AllBranchesScope" Text="All branches" />
            </SelectorBar>

            <AutoSuggestBox Width="260" PlaceholderText="Filter loaded commits"
                            QueryIcon="Find" VerticalAlignment="Center"
                            Text="{x:Bind Tab.Filter, Mode=TwoWay}" />

            <!-- Distinct from the box above: this one re-runs git log, so it can find commits that
                 were never loaded. -->
            <Button Content="Search history…" Click="Search_Click" VerticalAlignment="Center" />
            <Button Content="Clear search" Click="ClearSearch_Click" VerticalAlignment="Center"
                    Visibility="{x:Bind Tab.QueryVisibility, Mode=OneWay}" />

            <!-- Only present while a comparison is active, so there is always a way back out of it. -->
            <Button Click="StopComparing_Click" VerticalAlignment="Center"
                    Visibility="{x:Bind Tab.CompareVisibility, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                    <TextBlock Text="{x:Bind Tab.CompareDescription, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                          IsActive="{x:Bind Tab.IsLoading, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Tab.Status, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Text="{x:Bind Tab.QueryDescription, Mode=OneWay}"
                       Style="{StaticResource SecondaryTextStyle}" FontStyle="Italic"
                       Visibility="{x:Bind Tab.QueryVisibility, Mode=OneWay}" />
        </StackPanel>

        <!-- Commit list, then the details pane. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">

            <Grid RowDefinitions="*" Margin="16,0,0,0">

                <!-- No column labels: the rows identify themselves (lane, refs, subject, hash, author
                     avatar, age), and a header row outside the ListView cannot be kept aligned with
                     the virtualized rows inside it. -->
                <ListView x:Name="CommitList"
                          ItemsSource="{x:Bind Tab.Commits, Mode=OneWay}"
                          SelectedItem="{x:Bind Tab.SelectedCommit, Mode=TwoWay}"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource DiffLineItemStyle}">
                    <ListView.Footer>
                        <Button Content="Load more commits" Margin="8,10,0,14"
                                Click="LoadMore_Click"
                                Visibility="{x:Bind Tab.LoadMoreVisibility, Mode=OneWay}" />
                    </ListView.Footer>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CommitRowViewModel">
                            <Grid Height="{x:Bind RowHeight}" ColumnSpacing="10" Padding="8,0,8,0"
                                  RightTapped="CommitRow_RightTapped">
                                <!--
                                    The star column is deliberately last. A column placed after a
                                    star-sized one is arranged off the right of the screen here — the
                                    star takes an unbounded width — so the metadata leads and the
                                    subject, which is the part that should absorb the slack, ends the
                                    row. The first column is Auto, sized by the lane control's own
                                    bound Width, because ColumnDefinition.Width is a GridLength and
                                    cannot be bound to the graph builder's plain double.
                                -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Create branch here…" Click="CreateBranch_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE710;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Create tag here…" Click="CreateTag_Click" />
                                        <MenuFlyoutItem Text="Check out this commit" Click="CheckoutCommit_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Compare with the selected commit"
                                                        Click="CompareWith_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Cherry-pick" Click="CherryPick_Click" />
                                        <MenuFlyoutItem Text="Revert" Click="Revert_Click" />
                                        <MenuFlyoutItem Text="Rebase onto this…" Click="Rebase_Click" />
                                        <MenuFlyoutSubItem Text="Reset current branch to here">
                                            <MenuFlyoutItem Text="Soft — keep changes staged" Click="ResetSoft_Click" />
                                            <MenuFlyoutItem Text="Mixed — keep changes unstaged" Click="ResetMixed_Click" />
                                            <MenuFlyoutItem Text="Hard — discard changes" Click="ResetHard_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Bisect">
                                            <MenuFlyoutItem Text="Start" Click="BisectStart_Click" />
                                            <MenuFlyoutItem Text="Mark this commit good" Click="BisectGood_Click" />
                                            <MenuFlyoutItem Text="Mark this commit bad" Click="BisectBad_Click" />
                                            <MenuFlyoutItem Text="Reset" Click="BisectReset_Click" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Copy full hash" Click="CopyHash_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy subject" Click="CopySubject_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!-- Lane drawing: one Path per colour, in a Canvas whose coordinate
                                     space matches RowHeight. -->
                                <ItemsControl ItemsSource="{x:Bind GraphSegments}"
                                              Width="{x:Bind GraphColumnWidth}"
                                              VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="graph:GraphSegment">
                                            <Path Data="{x:Bind Geometry}" Stroke="{x:Bind Stroke}"
                                                  Fill="{x:Bind Fill}" StrokeThickness="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Column="1" Text="{x:Bind ShortHash}"
                                           Style="{StaticResource HashTextStyle}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <PersonPicture Width="18" Height="18"
                                                   Initials="{x:Bind AuthorInitials}"
                                                   Visibility="{x:Bind AvatarVisibility}" />
                                    <TextBlock Text="{x:Bind Author}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{x:Bind RelativeDate}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           ToolTipService.ToolTip="{x:Bind Date}" />

                                <!-- Ref chips sit inline before the subject. -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE895;" FontSize="12" Margin="0,0,2,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind PendingGlyphVisibility}" />
                                    <FontIcon Glyph="&#xE8AB;" FontSize="12" Margin="0,0,2,0"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind MergeGlyphVisibility}" />
                                    <ItemsControl ItemsSource="{x:Bind Refs}"
                                                  Visibility="{x:Bind RefsVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:RefBadge">
                                                <Border Style="{StaticResource RefBadgeStyle}"
                                                        Background="{x:Bind Background}">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="11"
                                                               Foreground="{x:Bind Foreground}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind Subject}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:PaneSplitter Grid.Column="1" Orientation="Vertical" Invert="True"
                                   Minimum="260" Maximum="900" Target="{x:Bind DetailsPane}"
                                   Visibility="{x:Bind Tab.DetailsVisibility, Mode=OneWay}" />

            <!-- Commit details and the files it touched. -->
            <Grid Grid.Column="2" x:Name="DetailsPane" Width="380" RowDefinitions="Auto,*"
                  Margin="0,0,16,0"
                  Visibility="{x:Bind Tab.DetailsVisibility, Mode=OneWay}">

                <Border Style="{StaticResource CardBorderStyle}" Padding="14,12,14,12">
                    <ScrollViewer MaxHeight="220">
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind Tab.SelectedCommitVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Tab.SelectedCommit.Subject, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PersonPicture Width="28" Height="28"
                                               Initials="{x:Bind Tab.SelectedCommit.AuthorInitials, Mode=OneWay}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Tab.SelectedCommit.Author, Mode=OneWay}" FontSize="13" />
                                    <TextBlock Text="{x:Bind Tab.SelectedCommit.AuthorEmail, Mode=OneWay}"
                                               Style="{StaticResource PageSubtitleStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Tab.SelectedCommit.Date, Mode=OneWay}"
                                       Style="{StaticResource PageSubtitleStyle}" />
                            <TextBlock Text="{x:Bind Tab.SelectedCommit.FullHash, Mode=OneWay}"
                                       Style="{StaticResource HashTextStyle}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Tab.SelectedCommit.Body, Mode=OneWay}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <TextBlock Text="Changed files" Style="{StaticResource SectionCaptionStyle}"
                               Margin="2,0,0,6" />
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <ListView ItemsSource="{x:Bind Tab.ChangedFiles, Mode=OneWay}"
                                  SelectedItem="{x:Bind Tab.SelectedChangedFile, Mode=TwoWay}"
                                  SelectionMode="Single" Padding="4"
                                  ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ChangedFileViewModel">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                        <TextBlock Text="{x:Bind Change}" Style="{StaticResource CodeTextStyle}"
                                                   Foreground="{x:Bind ChangeBrush}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Detail}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind DetailVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <controls:PaneSplitter Grid.Row="2" Orientation="Horizontal" Invert="True"
                               Minimum="120" Maximum="900" Target="{x:Bind DiffPane}" />

        <Border Grid.Row="3" x:Name="DiffPane" Height="300"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <views:DiffPanel Diff="{x:Bind Tab.HistoryDiff, Mode=OneWay}">
                <views:DiffPanel.ActionsContent>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Blame" Click="Blame_Click" />
                        <Button Content="File history" Click="FileHistory_Click" />
                    </StackPanel>
                </views:DiffPanel.ActionsContent>
            </views:DiffPanel>
        </Border>
    </Grid>
</views:RepositoryPage>
