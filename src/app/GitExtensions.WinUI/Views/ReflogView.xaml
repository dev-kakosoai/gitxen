<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.ReflogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GitExtensions.WinUI.Converters"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,16">

        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Reflog" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Every position HEAD has held, newest first."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Click="Refresh_Click" VerticalAlignment="Center" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
            </Button>
        </StackPanel>

        <InfoBar Grid.Row="1" Margin="0,12,0,0" IsOpen="True" IsClosable="False" Severity="Informational"
                 Title="This is the recovery path"
                 Message="Commits no branch points at any more are still listed here until git collects them. Reset to one, or branch from it, to get the work back." />

        <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:Show.IfNone(Tab.Reflog.Count), Mode=OneWay}">
            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="Nothing in the reflog" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                       Text="HEAD has not moved yet in this repository, so there is nothing to recover." />
        </StackPanel>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind conv:Show.IfAny(Tab.Reflog.Count), Mode=OneWay}">
            <ListView ItemsSource="{x:Bind Tab.Reflog, Mode=OneWay}" SelectionMode="Single" Padding="4"
                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <!-- Rows animate in as the listing refreshes; supported inline only,
                     a Transitions-typed style setter fails XAML parsing at runtime. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ReflogEntry">
                        <!-- Fixed widths rather than a star column: see BranchesView. -->
                        <Grid ColumnDefinitions="130,90,150,520,110" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Create branch here…" Click="CreateBranch_Click" />
                                    <MenuFlyoutItem Text="Check out this state" Click="Checkout_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Reset current branch here (hard)…" Click="ResetHard_Click" />
                                    <MenuFlyoutItem Text="Copy selector" Click="CopySelector_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <TextBlock Text="{x:Bind Selector}" Style="{StaticResource HashTextStyle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ShortHash}"
                                       Style="{StaticResource HashTextStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Action}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeBody}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Subject}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Date}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeBody}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</views:RepositoryPage>
