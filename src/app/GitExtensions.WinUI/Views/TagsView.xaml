<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.TagsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GitExtensions.WinUI.Converters"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,16">

        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Tags" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Named points in history, newest first."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Click="Refresh_Click" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:Show.IfNone(Tab.Tags.Count), Mode=OneWay}">
            <FontIcon Glyph="&#xE8EC;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="No tags" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                       Text="Right-click a commit on the History page to tag it." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0"
                Visibility="{x:Bind conv:Show.IfAny(Tab.Tags.Count), Mode=OneWay}">
            <ListView ItemsSource="{x:Bind Tab.Tags, Mode=OneWay}" SelectionMode="Single" Padding="4"
                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TagInfo">
                        <!-- Fixed widths rather than a star column: see BranchesView. -->
                        <Grid ColumnDefinitions="Auto,420,110,90,100" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Check out this tag" Click="Checkout_Click" />
                                    <MenuFlyoutItem Text="Push to remote…" Click="Push_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Copy name" Click="CopyName_Click" />
                                    <MenuFlyoutItem Text="Delete…" Click="Delete_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <FontIcon Glyph="&#xE8EC;" FontSize="13" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subject}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind conv:Show.IfText(Subject)}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind Kind}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ShortHash}"
                                       Style="{StaticResource HashTextStyle}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Date}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</views:RepositoryPage>
