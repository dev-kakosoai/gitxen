<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.GitConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <ScrollViewer>
        <StackPanel Padding="20,16,20,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
                <StackPanel Spacing="2">
                    <TextBlock Text="Git configuration" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Written with git config, so include directives and escaping stay git's business." />
                </StackPanel>
                <Button Click="Refresh_Click" VerticalAlignment="Center" AutomationProperties.Name="Reload" ToolTipService.ToolTip="Reload">
                    <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
            </StackPanel>

            <!-- Identity -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Identity" FontWeight="SemiBold" />
                        <TextBlock x:Name="IdentityHint" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                   Text="The name and address recorded on every commit you make. Leave the repository fields empty to use your global identity." />
                    </StackPanel>

                    <Grid ColumnSpacing="16" RowSpacing="10"
                          RowDefinitions="Auto,Auto,Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- Named so the page can zero it when Home hosts it with no repository. -->
                            <ColumnDefinition x:Name="LocalColumn" Width="300" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LocalHeader" Text="This repository"
                                   Style="{StaticResource ColumnHeaderStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="All repositories"
                                   Style="{StaticResource ColumnHeaderStyle}" />

                        <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" Width="90" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LocalName" PlaceholderText="(use global)" />
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="GlobalName" />

                        <TextBlock Grid.Row="2" Text="Email" VerticalAlignment="Center" Width="90" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="LocalEmail" PlaceholderText="(use global)" />
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="GlobalEmail" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="Behaviour" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="Auto,420,220" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource IconSizeLarge}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Line endings (core.autocrlf)" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                       Text="On Windows, 'true' checks out CRLF and commits LF. 'input' commits LF without converting on checkout." />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="AutoCrlfBox" MinWidth="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="(not set)" />
                            <ComboBoxItem Content="true" />
                            <ComboBoxItem Content="input" />
                            <ComboBoxItem Content="false" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,420,220" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE74B;" FontSize="{StaticResource IconSizeLarge}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pull strategy (pull.rebase)" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                       Text="What a plain pull does when both sides have new commits." />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="PullRebaseBox" MinWidth="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="(not set)" />
                            <ComboBoxItem Content="merge" />
                            <ComboBoxItem Content="rebase" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,420,220" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconSizeLarge}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Default branch name (init.defaultBranch)" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                       Text="Used for the first branch of repositories you create." />
                        </StackPanel>
                        <TextBox Grid.Column="2" x:Name="DefaultBranchBox" MinWidth="180"
                                 VerticalAlignment="Center" PlaceholderText="master" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save changes" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click" />
                <TextBlock Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <!-- Everything else, read-only -->
            <StackPanel Spacing="8" x:Name="RepositorySection">
                <TextBlock Text="All settings for this repository" Style="{StaticResource SectionCaptionStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Height="260">
                    <ListView ItemsSource="{x:Bind Tab.LocalConfig, Mode=OneWay}" SelectionMode="Single"
                              Padding="4" ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                        <!-- Rows animate in as the listing refreshes; supported inline only,
                             a Transitions-typed style setter fails XAML parsing at runtime. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <ReorderThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GitConfigEntry">
                                <!-- Fixed widths rather than a star column: a column after one is
                                     arranged off the screen here. -->
                                <Grid ColumnDefinitions="300,520" ColumnSpacing="14">
                                    <TextBlock Text="{x:Bind Key}" Style="{StaticResource CodeTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}"
                                               Style="{StaticResource CodeTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</views:RepositoryPage>
