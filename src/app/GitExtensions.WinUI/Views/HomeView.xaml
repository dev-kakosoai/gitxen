<UserControl
    x:Class="GitExtensions.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <!-- One repository row, shared by every group list and the ungrouped list. -->
        <DataTemplate x:Key="RecentRepositoryTemplate" x:DataType="models:RecentRepository">
            <!-- Fixed widths rather than a star column: a column after one is arranged off the
                 screen here. -->
            <Grid ColumnDefinitions="Auto,320,420,Auto" ColumnSpacing="14" Padding="6,4">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open" Click="OpenRecent_Click" />
                        <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Move to project" Click="MoveToGroup_Click" />
                        <MenuFlyoutItem Text="Remove from this list" Click="RemoveRecent_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Path}" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Branch, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind LastCommit, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Folder is missing or is no longer a repository"
                               FontSize="{StaticResource FontSizeCaption}" FontStyle="Italic"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{x:Bind MissingVisibility, Mode=OneWay}" />
                </StackPanel>

                <Button Grid.Column="3" Click="RemoveRecent_Click"
                        Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                        AutomationProperties.Name="Remove from list"
                        ToolTipService.ToolTip="Remove from list">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource IconSizeTiny}" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!--
            An abstract background illustration: soft colour washes and flowing branch-like curves
            with commit-node dots, in the brand hues, filling the empty right side of Home. Full
            height, behind everything, and faint enough that content scrolling over it stays
            readable — each element carries its own low opacity rather than one flat value, so the
            washes stay barely-there while the lines keep a hint of definition.
        -->
        <Viewbox HorizontalAlignment="Right" VerticalAlignment="Stretch" Stretch="Uniform"
                 IsHitTestVisible="False">
            <Canvas Width="720" Height="1000">

                <!-- Soft colour washes for depth. Each fades to a transparent version of its own
                     hue so the edge dissolves instead of greying out; the mid stop eases the
                     falloff, and they are kept large and very faint because a small, stronger
                     radial shows visible banding rings on the dark theme. -->
                <Ellipse Width="760" Height="760" Canvas.Left="280" Canvas.Top="-280" Opacity="0.045">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#58A6FF" />
                            <GradientStop Offset="0.55" Color="#5958A6FF" />
                            <GradientStop Offset="1" Color="#0058A6FF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="680" Height="680" Canvas.Left="220" Canvas.Top="540" Opacity="0.045">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#A874FF" />
                            <GradientStop Offset="0.55" Color="#59A874FF" />
                            <GradientStop Offset="1" Color="#00A874FF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="480" Height="480" Canvas.Left="50" Canvas.Top="250" Opacity="0.035">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#808DFF" />
                            <GradientStop Offset="0.55" Color="#59808DFF" />
                            <GradientStop Offset="1" Color="#00808DFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- The main line, weaving top to bottom through the fork point at 560,520. -->
                <Path Data="M 600,-30 C 520,150 660,330 560,520 C 470,690 640,850 560,1040"
                      Stroke="#58A6FF" StrokeThickness="3" Opacity="0.13"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- A second line running loosely alongside it. -->
                <Path Data="M 680,30 C 620,200 740,360 660,540 C 600,690 720,850 680,1040"
                      Stroke="#A874FF" StrokeThickness="3" Opacity="0.11"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- A branch peeling off the fork point towards the lower left. -->
                <Path Data="M 560,520 C 500,620 520,700 430,780 C 370,835 390,920 330,990"
                      Stroke="#808DFF" StrokeThickness="3" Opacity="0.11"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- A short dotted branch drifting into the middle space. -->
                <Path Data="M 585,260 C 500,320 520,390 420,440"
                      Stroke="#58A6FF" StrokeThickness="3" Opacity="0.11"
                      StrokeDashArray="0.1 4" StrokeDashCap="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <!-- Commit nodes: filled at the fork, rings at the branch tips, all centred on
                     curve endpoints so they sit exactly on their lines. -->
                <Ellipse Width="16" Height="16" Canvas.Left="552" Canvas.Top="512"
                         Fill="#808DFF" Opacity="0.16" />
                <Ellipse Width="14" Height="14" Canvas.Left="413" Canvas.Top="433"
                         Stroke="#58A6FF" StrokeThickness="3" Opacity="0.14" />
                <Ellipse Width="14" Height="14" Canvas.Left="323" Canvas.Top="983"
                         Stroke="#808DFF" StrokeThickness="3" Opacity="0.14" />
                <Ellipse Width="12" Height="12" Canvas.Left="654" Canvas.Top="534"
                         Fill="#A874FF" Opacity="0.14" />
                <Ellipse Width="10" Height="10" Canvas.Left="585" Canvas.Top="255"
                         Fill="#58A6FF" Opacity="0.14" />
            </Canvas>
        </Viewbox>

        <ScrollViewer x:Name="MainContent">
        <StackPanel Padding="40,32,40,40" Spacing="28" MaxWidth="1080" HorizontalAlignment="Left">

            <StackPanel Spacing="6">
                <TextBlock Text="Gitxen" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" FontSize="{StaticResource FontSizeBodyLarge}"
                           Text="A free, open-source git client for Windows. Open a repository to get started." />
            </StackPanel>

            <!-- Start -->
            <StackPanel Spacing="10">
                <TextBlock Text="Start" Style="{StaticResource SectionCaptionStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="Open_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Open repository" />
                        </StackPanel>
                    </Button>

                    <Button Click="Clone_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Clone from URL" />
                        </StackPanel>
                    </Button>

                    <Button Click="Init_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Create empty repository" />
                        </StackPanel>
                    </Button>

                    <!--
                        Scanning a folder for repositories is the setup wizard's job, and it is worth
                        reaching without waiting for a first run: it is how a second projects folder,
                        or a machine that already had work on it, gets imported.
                    -->
                    <Button Click="Setup_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D5;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Find repositories" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="You can also drop a folder anywhere on this window." />
            </StackPanel>

            <!-- Projects and recent repositories -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Projects" Style="{StaticResource SectionCaptionStyle}"
                               VerticalAlignment="Center" />
                    <Button Click="NewGroup_Click" Padding="8,2" FontSize="{StaticResource FontSizeCaption}"
                            AutomationProperties.Name="New project group" ToolTipService.ToolTip="Group repositories that are worked on together">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="New group" />
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshRecent_Click" Padding="8,2" FontSize="{StaticResource FontSizeCaption}"
                            ToolTipService.ToolTip="Re-read each repository's current branch">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeSmall}" />
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Drag a repository onto a group to move it there." />

                <!-- One card per group. The header carries the group's colour and icon so a project is
                     recognisable without reading the name. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RepositoryGroup">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto">

                                    <Border Background="{x:Bind Tint, Mode=OneWay}" CornerRadius="8,8,0,0"
                                            Padding="12,8" AllowDrop="True"
                                            DragOver="Group_DragOver" Drop="Group_Drop" Tag="{x:Bind}"
                                            Tapped="GroupHeader_Tapped">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                                            <Button Click="ToggleGroup_Click" Tag="{x:Bind}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Collapse or expand"
                                                    ToolTipService.ToolTip="Collapse or expand">
                                                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource IconSizeTiny}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform Angle="{x:Bind ChevronRotation, Mode=OneWay}" />
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Button>

                                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                      FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                                                      Foreground="{x:Bind Accent, Mode=OneWay}" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"
                                                           MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}"
                                                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <!--
                                                Rename and delete are one-per-project actions that are
                                                found when they are wanted, so they sit behind a menu
                                                rather than spending two labelled buttons on every
                                                header.
                                            -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    AutomationProperties.Name="Project options"
                                                    ToolTipService.ToolTip="Project options">
                                                <FontIcon Glyph="&#xE712;" FontSize="{StaticResource IconSizeSmall}" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="Rename or restyle..."
                                                                        Click="EditGroup_Click" Tag="{x:Bind}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete project"
                                                                        Click="DeleteGroup_Click" Tag="{x:Bind}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ListView Grid.Row="1" ItemsSource="{x:Bind Repositories, Mode=OneWay}"
                                              Visibility="{x:Bind ContentVisibility, Mode=OneWay}"
                                              SelectionMode="None" Padding="6"
                                              CanDragItems="True" AllowDrop="True" Tag="{x:Bind}"
                                              DragItemsStarting="Repositories_DragItemsStarting"
                                              DragOver="Group_DragOver" Drop="Group_Drop"
                                              IsItemClickEnabled="True" ItemClick="Recent_ItemClick"
                                              ItemTemplate="{StaticResource RecentRepositoryTemplate}"
                                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Everything not in a group. Also a drop target, so a repository can be taken out. -->
                <StackPanel Spacing="6" Visibility="{x:Bind UngroupedCaptionVisibility, Mode=OneWay}">
                    <TextBlock Text="Not in a project" Style="{StaticResource SectionCaptionStyle}"
                               Margin="2,6,0,0" />
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind EmptyRecentVisibility}">
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Nothing yet. Repositories you open will be listed here." />
                </StackPanel>

                <!-- No card around the ungrouped list: a border and fill would read as one more
                     project, and these rows are precisely the ones in none. -->
                <ListView ItemsSource="{x:Bind ViewModel.Ungrouped.Repositories, Mode=OneWay}"
                          Visibility="{x:Bind UngroupedCaptionVisibility, Mode=OneWay}"
                          SelectionMode="None" Padding="0"
                          CanDragItems="True" AllowDrop="True"
                          DragItemsStarting="Repositories_DragItemsStarting"
                          DragOver="Group_DragOver" Drop="Ungrouped_Drop"
                          IsItemClickEnabled="True" ItemClick="Recent_ItemClick"
                          ItemTemplate="{StaticResource RecentRepositoryTemplate}"
                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}" />
            </StackPanel>

            <!-- Layout preference -->
            <StackPanel Spacing="10">
                <TextBlock Text="Layout" Style="{StaticResource SectionCaptionStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid ColumnDefinitions="Auto,440,240" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8A1;" FontSize="{StaticResource IconSizeLarge}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Show open repositories as" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                       Text="A column suits long names and many repositories; tabs suit a few." />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="LayoutBox" MinWidth="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="Layout_SelectionChanged">
                            <ComboBoxItem Content="Tabs across the top" />
                            <ComboBoxItem Content="Column on the left" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!--
                Settings that are not about any one repository, so they should not require opening
                one. Each card opens its own page over Home rather than expanding inline — a settings
                page deserves the full width, and the lists above should not jump around underneath
                it. The repository-scoped pages — Maintenance, the local half of Git config, the
                status bar — stay inside the repository, where the thing they act on is.
            -->
            <StackPanel Spacing="10">
                <TextBlock Text="Settings" Style="{StaticResource SectionCaptionStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="OpenAppSettings_Click" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,250,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="{StaticResource IconSizeLarge}"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Application settings" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                           Text="Theme, density, performance limits, reset" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="{StaticResource IconSizeSmall}"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Button>

                    <Button Click="OpenGitConfig_Click" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,250,Auto" ColumnSpacing="12">
                            <FontIcon Glyph="&#xE9F5;" FontSize="{StaticResource IconSizeLarge}"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Git configuration" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                           Text="Identity and defaults for all repositories" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="{StaticResource IconSizeSmall}"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!--
            Home's sub-pages. Swapped by visibility like every other section in the app, so a
            half-edited identity or a scroll position survives going back and forth. Each page
            carries its own title and scrolling; the strip here is only the way back.
        -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,12,20,0">
                <Button Click="BackToHome_Click" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Back to Home" ToolTipService.ToolTip="Back to Home">
                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
                <TextBlock Text="Home" VerticalAlignment="Center"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <views:SettingsView Grid.Row="1" x:Name="AppSettings" />
        </Grid>

        <Grid x:Name="GitConfigPage" Visibility="Collapsed" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,12,20,0">
                <Button Click="BackToHome_Click" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Back to Home" ToolTipService.ToolTip="Back to Home">
                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
                <TextBlock Text="Home" VerticalAlignment="Center"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <views:GitConfigView Grid.Row="1" x:Name="GlobalConfig" />
        </Grid>
    </Grid>
</UserControl>
