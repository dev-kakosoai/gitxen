<UserControl
    x:Class="GitExtensions.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <UserControl.Resources>
        <!-- One repository row, shared by every group list and the ungrouped list. -->
        <DataTemplate x:Key="RecentRepositoryTemplate" x:DataType="models:RecentRepository">
            <!-- Fixed widths rather than a star column: a column after one is arranged off the
                 screen here. -->
            <Grid ColumnDefinitions="Auto,320,420" ColumnSpacing="14" Padding="6,4">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open" Click="OpenRecent_Click" />
                        <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Move to project" Click="MoveToGroup_Click" />
                        <MenuFlyoutItem Text="Remove from this list" Click="RemoveRecent_Click" />
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Path}" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Branch, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind LastCommit, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Folder is missing or is no longer a repository"
                               FontSize="{StaticResource FontSizeCaption}" FontStyle="Italic"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{x:Bind MissingVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!--
            The mark as a watermark: full height, anchored to the right where Home's empty space is,
            and behind everything at an opacity low enough that content scrolling over it stays
            readable. Drawn in XAML shapes rather than the SVG because SvgImageSource's renderer does
            not support the mask the SVG punches its centre node with; the geometry here matches
            gitxen.svg, with the punch simulated by a circle in the gradient's midpoint colour.
        -->
        <Viewbox HorizontalAlignment="Right" VerticalAlignment="Stretch" Stretch="Uniform"
                 Opacity="0.06" IsHitTestVisible="False">
            <Grid Width="256" Height="256">
                <Rectangle RadiusX="56" RadiusY="56">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#58A6FF" />
                            <GradientStop Offset="1" Color="#A874FF" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Line X1="76.8" Y1="76.8" X2="179.2" Y2="179.2" Stroke="White" StrokeThickness="29.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line X1="179.2" Y1="76.8" X2="76.8" Y2="179.2" Stroke="White" StrokeThickness="29.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                <Ellipse Width="40" Height="40" Fill="White" Margin="56.8,56.8,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse Width="40" Height="40" Fill="White" Margin="159.2,56.8,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse Width="40" Height="40" Fill="White" Margin="56.8,159.2,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse Width="40" Height="40" Fill="White" Margin="159.2,159.2,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Ellipse Width="34.8" Height="34.8" Fill="#808DFF" Margin="110.6,110.6,0,0"
                         HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </Viewbox>

        <ScrollViewer>
        <StackPanel Padding="40,32,40,40" Spacing="28" MaxWidth="1080" HorizontalAlignment="Left">

            <StackPanel Spacing="6">
                <TextBlock Text="Gitxen" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" FontSize="{StaticResource FontSizeBodyLarge}"
                           Text="A free, open-source git client for Windows. Open a repository to get started." />
            </StackPanel>

            <!-- Start -->
            <StackPanel Spacing="10">
                <TextBlock Text="Start" Style="{StaticResource SectionCaptionStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="Open_Click" Style="{ThemeResource AccentButtonStyle}" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Open repository" />
                        </StackPanel>
                    </Button>

                    <Button Click="Clone_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Clone from URL" />
                        </StackPanel>
                    </Button>

                    <Button Click="Init_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Create empty repository" />
                        </StackPanel>
                    </Button>

                    <!--
                        Scanning a folder for repositories is the setup wizard's job, and it is worth
                        reaching without waiting for a first run: it is how a second projects folder,
                        or a machine that already had work on it, gets imported.
                    -->
                    <Button Click="Setup_Click" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D5;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Find repositories" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="You can also drop a folder anywhere on this window." />
            </StackPanel>

            <!-- Projects and recent repositories -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Projects" Style="{StaticResource SectionCaptionStyle}"
                               VerticalAlignment="Center" />
                    <Button Click="NewGroup_Click" Padding="8,2" FontSize="{StaticResource FontSizeCaption}"
                            AutomationProperties.Name="New project group" ToolTipService.ToolTip="Group repositories that are worked on together">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="{StaticResource IconSizeSmall}" />
                            <TextBlock Text="New group" />
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshRecent_Click" Padding="8,2" FontSize="{StaticResource FontSizeCaption}"
                            ToolTipService.ToolTip="Re-read each repository's current branch">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeSmall}" />
                    </Button>
                </StackPanel>

                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Drag a repository onto a group to move it there." />

                <!-- One card per group. The header carries the group's colour and icon so a project is
                     recognisable without reading the name. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RepositoryGroup">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid RowDefinitions="Auto,Auto">

                                    <Border Background="{x:Bind Tint, Mode=OneWay}" CornerRadius="8,8,0,0"
                                            Padding="12,8" AllowDrop="True"
                                            DragOver="Group_DragOver" Drop="Group_Drop" Tag="{x:Bind}"
                                            Tapped="GroupHeader_Tapped">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                                            <Button Click="ToggleGroup_Click" Tag="{x:Bind}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Collapse or expand"
                                                    ToolTipService.ToolTip="Collapse or expand">
                                                <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource IconSizeTiny}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform Angle="{x:Bind ChevronRotation, Mode=OneWay}" />
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Button>

                                            <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                      FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                                                      Foreground="{x:Bind Accent, Mode=OneWay}" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"
                                                           MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}"
                                                           VerticalAlignment="Center" FontSize="{StaticResource FontSizeBody}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <!--
                                                Rename and delete are one-per-project actions that are
                                                found when they are wanted, so they sit behind a menu
                                                rather than spending two labelled buttons on every
                                                header.
                                            -->
                                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    AutomationProperties.Name="Project options"
                                                    ToolTipService.ToolTip="Project options">
                                                <FontIcon Glyph="&#xE712;" FontSize="{StaticResource IconSizeSmall}" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="Rename or restyle..."
                                                                        Click="EditGroup_Click" Tag="{x:Bind}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete project"
                                                                        Click="DeleteGroup_Click" Tag="{x:Bind}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ListView Grid.Row="1" ItemsSource="{x:Bind Repositories, Mode=OneWay}"
                                              Visibility="{x:Bind ContentVisibility, Mode=OneWay}"
                                              SelectionMode="None" Padding="6"
                                              CanDragItems="True" AllowDrop="True" Tag="{x:Bind}"
                                              DragItemsStarting="Repositories_DragItemsStarting"
                                              DragOver="Group_DragOver" Drop="Group_Drop"
                                              IsItemClickEnabled="True" ItemClick="Recent_ItemClick"
                                              ItemTemplate="{StaticResource RecentRepositoryTemplate}"
                                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Everything not in a group. Also a drop target, so a repository can be taken out. -->
                <StackPanel Spacing="6" Visibility="{x:Bind UngroupedCaptionVisibility, Mode=OneWay}">
                    <TextBlock Text="Not in a project" Style="{StaticResource SectionCaptionStyle}"
                               Margin="2,6,0,0" />
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind EmptyRecentVisibility}">
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Nothing yet. Repositories you open will be listed here." />
                </StackPanel>

                <!-- No card around the ungrouped list: a border and fill would read as one more
                     project, and these rows are precisely the ones in none. -->
                <ListView ItemsSource="{x:Bind ViewModel.Ungrouped.Repositories, Mode=OneWay}"
                          Visibility="{x:Bind UngroupedCaptionVisibility, Mode=OneWay}"
                          SelectionMode="None" Padding="0"
                          CanDragItems="True" AllowDrop="True"
                          DragItemsStarting="Repositories_DragItemsStarting"
                          DragOver="Group_DragOver" Drop="Ungrouped_Drop"
                          IsItemClickEnabled="True" ItemClick="Recent_ItemClick"
                          ItemTemplate="{StaticResource RecentRepositoryTemplate}"
                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}" />
            </StackPanel>

            <!-- Layout preference -->
            <StackPanel Spacing="10">
                <TextBlock Text="Layout" Style="{StaticResource SectionCaptionStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <Grid ColumnDefinitions="Auto,440,240" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE8A1;" FontSize="{StaticResource IconSizeLarge}" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Show open repositories as" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                                       Text="A column suits long names and many repositories; tabs suit a few." />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="LayoutBox" MinWidth="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="Layout_SelectionChanged">
                            <ComboBoxItem Content="Tabs across the top" />
                            <ComboBoxItem Content="Column on the left" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!--
                Settings that are not about any one repository, so they should not require opening
                one. The repository-scoped pages — Maintenance, the local half of Git config, the
                status bar — stay inside the repository, where the thing they act on is.
            -->
            <StackPanel Spacing="10">
                <TextBlock Text="Settings" Style="{StaticResource SectionCaptionStyle}" />

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Expanding="AppSettings_Expanding">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Application settings" />
                        </StackPanel>
                    </Expander.Header>
                    <views:SettingsView x:Name="AppSettings" />
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Expanding="GlobalConfig_Expanding">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9F5;" FontSize="{StaticResource IconSizeMedium}" />
                            <TextBlock Text="Git configuration for all repositories" />
                        </StackPanel>
                    </Expander.Header>
                    <views:GitConfigView x:Name="GlobalConfig" />
                </Expander>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
