<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.SubmodulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:GitExtensions.WinUI.Converters"
    xmlns:models="using:GitExtensions.WinUI.Models"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,16">

        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Submodules" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Nested repositories this one pins to a commit."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Update all" Click="UpdateAll_Click" />
                <Button Content="Sync" Click="Sync_Click"
                        AutomationProperties.Name="Refresh submodules" ToolTipService.ToolTip="Re-read submodule URLs from .gitmodules" />
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource IconSizeMedium}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:Show.IfNone(Tab.Submodules.Count), Mode=OneWay}">
            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="No submodules" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                       Text="This repository does not reference any nested repositories." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0"
                Visibility="{x:Bind conv:Show.IfAny(Tab.Submodules.Count), Mode=OneWay}">
            <ListView ItemsSource="{x:Bind Tab.Submodules, Mode=OneWay}" SelectionMode="Single" Padding="4"
                      ItemContainerStyle="{StaticResource DenseListViewItemStyle}">
                <!-- Rows animate in as the listing refreshes; supported inline only,
                     a Transitions-typed style setter fails XAML parsing at runtime. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SubmoduleInfo">
                        <!-- Fixed widths rather than a star column: see BranchesView. -->
                        <Grid ColumnDefinitions="Auto,480,220,90" ColumnSpacing="12">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Update this submodule" Click="Update_Click" />
                                    <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <!-- The state marker is the reason to look at this page at all, so it leads. -->
                            <FontIcon Glyph="&#xE7BA;" FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      Visibility="{x:Bind conv:Show.If(NeedsAttention)}" />
                            <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource IconSizeSmall}" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      Visibility="{x:Bind conv:Show.IfNot(NeedsAttention)}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Described}" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind conv:Show.IfText(Described)}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind StateText}"
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource FontSizeCaption}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ShortHash}"
                                       Style="{StaticResource HashTextStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</views:RepositoryPage>
