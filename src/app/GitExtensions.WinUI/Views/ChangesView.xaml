<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.ChangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitExtensions.WinUI"
    xmlns:controls="using:GitExtensions.WinUI.Controls"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <UserControl.Resources>
        <!-- One row in either the staged or unstaged list. The action buttons carry the file itself in
             Tag so a single handler can serve every row. -->
        <DataTemplate x:Key="ChangedFileTemplate" x:DataType="local:ChangedFileViewModel">
            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Discard changes…" Click="Discard_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <TextBlock Text="{x:Bind Change}" Style="{StaticResource CodeTextStyle}"
                           Foreground="{x:Bind ChangeBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind Kind}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind DetailVisibility}" />
                </StackPanel>

                <Button Grid.Column="2" Click="ToggleStage_Click" Tag="{x:Bind}"
                        Padding="6,2" FontSize="11"
                        ToolTipService.ToolTip="Stage or unstage this file">
                    <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="20,16,20,10" Spacing="2">
            <TextBlock Text="Changes" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}">
                <Run Text="Committing to" />
                <Run Text="{x:Bind Tab.Branch, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </StackPanel>

        <!-- Nothing to commit. -->
        <StackPanel Grid.Row="1" Spacing="10" VerticalAlignment="Center"
                    Visibility="{x:Bind Tab.Changes.CleanVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="Working directory clean" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                       Text="Nothing has changed since the last commit. Edit a file and it will show up here." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*"
              Visibility="{x:Bind Tab.Changes.ChangesVisibility, Mode=OneWay}">

            <!-- The two staging lists and the message being composed. -->
            <Grid x:Name="StagingPane" Width="400" Margin="20,0,0,16"
                  RowDefinitions="Auto,*,Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Not staged" Style="{StaticResource SectionCaptionStyle}" />
                        <InfoBadge Value="{x:Bind Tab.Changes.UnstagedCount, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Stage all" Click="StageAll_Click"
                            Padding="8,2" FontSize="12" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" MinHeight="90">
                    <ListView ItemsSource="{x:Bind Tab.Changes.Unstaged, Mode=OneWay}"
                              SelectedItem="{x:Bind Tab.Changes.SelectedUnstaged, Mode=TwoWay}"
                              ItemTemplate="{StaticResource ChangedFileTemplate}"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                              SelectionMode="Single" Padding="4" />
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,14,2,6">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Staged" Style="{StaticResource SectionCaptionStyle}" />
                        <InfoBadge Value="{x:Bind Tab.Changes.StagedCount, Mode=OneWay}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Unstage all" Click="UnstageAll_Click"
                            Padding="8,2" FontSize="12" />
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" MinHeight="90">
                    <ListView ItemsSource="{x:Bind Tab.Changes.Staged, Mode=OneWay}"
                              SelectedItem="{x:Bind Tab.Changes.SelectedStaged, Mode=TwoWay}"
                              ItemTemplate="{StaticResource ChangedFileTemplate}"
                              ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                              SelectionMode="Single" Padding="4" />
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}"
                        Padding="12" Margin="0,14,0,0">
                    <StackPanel Spacing="10">
                        <TextBox PlaceholderText="Commit message"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                 Text="{x:Bind Tab.Changes.Message, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <CheckBox Content="Amend" Checked="Amend_Checked"
                                          IsChecked="{x:Bind Tab.Changes.IsAmend, Mode=TwoWay}" />
                                <CheckBox Content="Sign off"
                                          IsChecked="{x:Bind Tab.Changes.IsSignOff, Mode=TwoWay}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}"
                                    Content="{x:Bind Tab.Changes.CommitButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind Tab.Changes.CanCommit, Mode=OneWay}"
                                    Click="Commit_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <controls:PaneSplitter Grid.Column="1" Orientation="Vertical"
                                   Minimum="300" Maximum="800" Target="{x:Bind StagingPane}" />

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,20,16">
                <views:DiffPanel Diff="{x:Bind Tab.Changes.Diff, Mode=OneWay}" />
            </Border>
        </Grid>
    </Grid>
</views:RepositoryPage>
