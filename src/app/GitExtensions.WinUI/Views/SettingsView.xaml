<views:RepositoryPage
    x:Class="GitExtensions.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <ScrollViewer>
        <StackPanel Padding="20,16,20,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Applies to every open repository."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Appearance -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid ColumnDefinitions="Auto,440,180" ColumnSpacing="14">
                    <FontIcon Glyph="&#xE771;" FontSize="18" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Theme" FontWeight="SemiBold" />
                        <TextBlock Text="Follows Windows unless you pick one."
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="ThemeBox" MinWidth="140"
                              VerticalAlignment="Center"
                              SelectionChanged="Theme_SelectionChanged">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Performance limits -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,440,180" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE81C;" FontSize="18" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Commits per page" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="How much history to read at a time. Larger pages mean slower first paint." />
                        </StackPanel>
                        <NumberBox Grid.Column="2" x:Name="CommitsBox" MinWidth="140"
                                   VerticalAlignment="Center"
                                   Minimum="100" Maximum="50000" SpinButtonPlacementMode="Compact"
                                   ValueChanged="Commits_ValueChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,440,180" ColumnSpacing="14">
                        <FontIcon Glyph="&#xE7C3;" FontSize="18" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Maximum diff lines" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="Longer diffs are truncated, with a note saying how much was left out." />
                        </StackPanel>
                        <NumberBox Grid.Column="2" x:Name="DiffLinesBox" MinWidth="140"
                                   VerticalAlignment="Center"
                                   Minimum="100" Maximum="200000" SpinButtonPlacementMode="Compact"
                                   ValueChanged="DiffLines_ValueChanged" />
                    </Grid>

                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                             Message="Both limits take effect on the next refresh." />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="About" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                               Text="An experimental WinUI 3 front-end for Git Extensions. It drives the same git backend as the WinForms app and is staged alongside it rather than replacing it." />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                               Text="Session state — open repositories, window position and these settings — is kept in %LOCALAPPDATA%\GitExtensions.WinUI." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</views:RepositoryPage>
