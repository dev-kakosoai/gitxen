<UserControl
    x:Class="GitExtensions.WinUI.Views.DiffPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitExtensions.WinUI"
    xmlns:controls="using:GitExtensions.WinUI.Controls"
    xmlns:diff="using:GitExtensions.WinUI.Diff"
    x:Name="PanelRoot"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">

    <Grid RowDefinitions="Auto,*">

        <!--
            Header: which file, how to show it, and whatever actions the host page adds. Laid out as one
            left-aligned run: content placed at the far right of a full-width bar does not paint here, and
            the file name plus its controls belong together anyway.

            The file name is capped rather than star-sized so a deep path ellipsises instead of pushing
            the controls along in front of it.
        -->
        <Grid Grid.Row="0" Padding="12,8,12,8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE7C3;" FontSize="{StaticResource IconSizeMedium}" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Visibility="{x:Bind Diff.ContentVisibility, Mode=OneWay}" />

                <TextBlock Text="{x:Bind Diff.Title, Mode=OneWay}"
                           Style="{StaticResource CodeTextStyle}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           MaxWidth="520" TextTrimming="CharacterEllipsis" />

                <SelectorBar x:Name="ViewModeBar"
                             SelectionChanged="ViewModeBar_SelectionChanged"
                             Visibility="{x:Bind Diff.ContentVisibility, Mode=OneWay}">
                    <SelectorBarItem x:Name="UnifiedItem" Text="Unified" IsSelected="True" />
                    <SelectorBarItem x:Name="SideBySideItem" Text="Side by side" />
                </SelectorBar>

                <ContentPresenter Content="{x:Bind ActionsContent, Mode=OneWay}"
                                  VerticalAlignment="Center" />

                <ProgressRing Width="14" Height="14" VerticalAlignment="Center"
                              IsActive="{x:Bind Diff.IsLoading, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Nothing selected yet. -->
        <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center"
                    Visibility="{x:Bind Diff.PlaceholderVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE7C3;" Style="{StaticResource EmptyStateGlyphStyle}" />
            <TextBlock Text="No file selected" Style="{StaticResource EmptyStateBodyStyle}" />
        </StackPanel>

        <!-- Unified -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind Diff.Lines, Mode=OneWay}"
                  SelectionMode="None" Padding="8,0,8,8"
                  Visibility="{x:Bind Diff.UnifiedVisibility, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource DiffLineItemStyle}"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DiffLineViewModel">
                    <!-- The hunk action column comes before the star column: a column after one is
                         arranged off the screen here. -->
                    <Grid ColumnDefinitions="44,44,Auto,*" Background="{x:Bind Background}">
                        <TextBlock Text="{x:Bind OldLineNumber}" Style="{StaticResource CodeTextStyle}"
                                   FontSize="{StaticResource FontSizeCaption}" Opacity="0.45" TextAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind NewLineNumber}"
                                   Style="{StaticResource CodeTextStyle}"
                                   FontSize="{StaticResource FontSizeCaption}" Opacity="0.45" TextAlignment="Right" Margin="0,0,10,0" />

                        <!-- Only hunk headers carry this; every other row collapses it to nothing. -->
                        <Button Grid.Column="2" Tag="{x:Bind Hunk}" Click="HunkAction_Click"
                                Padding="8,0" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,10,0"
                                Visibility="{x:Bind HunkActionVisibility}"
                                Content="{Binding ElementName=PanelRoot, Path=Diff.HunkActionLabel}"
                                ToolTipService.ToolTip="{x:Bind HunkSummary}" />

                        <TextBlock Grid.Column="3" controls:DiffTextBehavior.Line="{x:Bind}"
                                   Style="{StaticResource CodeTextStyle}"
                                   IsTextSelectionEnabled="True" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Side by side -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind Diff.SideBySideLines, Mode=OneWay}"
                  SelectionMode="None" Padding="8,0,8,8"
                  Visibility="{x:Bind Diff.SideBySideVisibility, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource DiffLineItemStyle}"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="diff:SideBySideRow">
                    <Grid ColumnDefinitions="*,1,*" ColumnSpacing="6">
                        <Grid ColumnDefinitions="44,*" Background="{x:Bind Left.Background}">
                            <TextBlock Text="{x:Bind Left.OldLineNumber}" Style="{StaticResource CodeTextStyle}"
                                       FontSize="{StaticResource FontSizeCaption}" Opacity="0.45" TextAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" controls:DiffTextBehavior.Line="{x:Bind Left}"
                                       Style="{StaticResource CodeTextStyle}"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                        <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Grid.Column="2" ColumnDefinitions="44,*" Background="{x:Bind Right.Background}">
                            <TextBlock Text="{x:Bind Right.NewLineNumber}" Style="{StaticResource CodeTextStyle}"
                                       FontSize="{StaticResource FontSizeCaption}" Opacity="0.45" TextAlignment="Right" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" controls:DiffTextBehavior.Line="{x:Bind Right}"
                                       Style="{StaticResource CodeTextStyle}"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
