<Window
    x:Class="GitExtensions.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GitExtensions.WinUI.ViewModels"
    xmlns:views="using:GitExtensions.WinUI.Views">

    <!-- Mica ties the window to the desktop behind it; the shell's own surfaces are the layer
         brushes, which are semi-transparent over it. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OpenRepositoryAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="OpenRepositoryAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="RefreshAccelerator_Invoked" />
            <!-- Zen is deliberately undiscoverable: no button, hotkey only. -->
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="ZenAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--
            Custom title bar. The interactive controls sit to the left and the draggable region is the
            empty space to their right: a control inside the element passed to SetTitleBar cannot
            receive input, and the far right of the row belongs to the system caption buttons.
        -->
        <Grid Grid.Row="0" Height="48" Padding="14,0,0,0" ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="14"
              Visibility="{x:Bind ViewModel.ToolbarVisibility, Mode=OneWay}">

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8AB;" FontSize="15"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Git Extensions" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <SplitButton Click="OpenRepository_SplitClick">
                    <SplitButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                            <TextBlock Text="Open repository" />
                        </StackPanel>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="RecentFlyout" Placement="Bottom" />
                    </SplitButton.Flyout>
                </SplitButton>

                <!-- Simple keeps the everyday view; Advanced adds the details pane, the commit filter
                     and the extra history columns. -->
                <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged">
                    <SelectorBarItem x:Name="SimpleModeItem" Text="Simple" IsSelected="True" />
                    <SelectorBarItem x:Name="AdvancedModeItem" Text="Advanced" />
                </SelectorBar>
            </StackPanel>

            <Border Grid.Column="2" x:Name="TitleBarDragRegion" Background="Transparent" />
        </Grid>

        <!--
            The tab strip only. The repository itself is hosted in row 2 rather than inside the
            TabViewItem: TabView arranges its content at the content's own desired size instead of
            filling the area it was given, which left short pages (a repository with no branches, say)
            floating in a third of the window. A plain star-sized Grid row does stretch.
        -->
        <TabView Grid.Row="1" x:Name="RepositoryTabs" VerticalAlignment="Top"
                 TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                 IsAddTabButtonVisible="{x:Bind ViewModel.IsAddTabButtonVisible, Mode=OneWay}"
                 AddTabButtonClick="RepositoryTabs_AddTabButtonClick"
                 TabCloseRequested="RepositoryTabs_TabCloseRequested"
                 Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryTabViewModel">
                    <TabViewItem Header="{x:Bind Title}" IsClosable="True"
                                 ToolTipService.ToolTip="{x:Bind WorkingDir}">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8B7;" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- One view, showing whichever repository the strip has selected. -->
        <views:RepositoryView Grid.Row="2" Tab="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}" />

        <!-- First run, or every repository closed. -->
        <StackPanel Grid.Row="2" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE8B7;" FontSize="52"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No repository open" Style="{StaticResource EmptyStateTitleStyle}" />
            <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                       Text="Open a git working directory to see its history, stage changes and manage its branches. You can also drop a folder anywhere on this window." />
            <Button Content="Open repository" Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Click="OpenRepository_Click" />
        </StackPanel>

    </Grid>
</Window>
