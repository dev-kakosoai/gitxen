<Window
    x:Class="GitExtensions.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitExtensions.WinUI"
    xmlns:controls="using:GitExtensions.WinUI.Controls"
    xmlns:diff="using:GitExtensions.WinUI.Diff"
    xmlns:graph="using:GitExtensions.WinUI.Graph"
    xmlns:vm="using:GitExtensions.WinUI.ViewModels">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*"
          AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="OpenRepositoryAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="RefreshAccelerator_Invoked" />
            <!-- Zen is deliberately undiscoverable: no button, hotkey only. -->
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="ZenAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="Auto,*,Auto"
              Visibility="{x:Bind ViewModel.ToolbarVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SplitButton Click="OpenRepository_SplitClick">
                    <SplitButton.Content>Open Repository…</SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="RecentFlyout" Placement="Bottom" />
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Content="Refresh" Click="Refresh_Click" />
                <AppBarSeparator />
                <!-- Simple mode keeps only the everyday actions; the rest are Advanced-only. -->
                <Button Content="Commit…" Click="Commit_Click" />
                <Button Content="Pull" Click="Pull_Click" />
                <Button Content="Fetch" Click="Fetch_Click"
                        Visibility="{x:Bind ViewModel.AdvancedVisibility, Mode=OneWay}" />
                <Button Content="Push" Click="Push_Click"
                        Visibility="{x:Bind ViewModel.AdvancedVisibility, Mode=OneWay}" />
                <Button Content="Branch…" Visibility="{x:Bind ViewModel.AdvancedVisibility, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Create branch…" Click="CreateBranch_Click" />
                            <MenuFlyoutItem Text="Delete branch…" Click="DeleteBranch_Click" />
                            <MenuFlyoutItem Text="Merge branch into current…" Click="MergeBranch_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Stash changes…" Click="StashSave_Click" />
                            <MenuFlyoutItem Text="Show stashes" Click="StashList_Click" />
                            <MenuFlyoutItem Text="Pop latest stash" Click="StashPop_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="History…" Visibility="{x:Bind ViewModel.AdvancedVisibility, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Cherry-pick selected commit" Click="CherryPick_Click" />
                            <MenuFlyoutItem Text="Revert selected commit" Click="Revert_Click" />
                            <MenuFlyoutItem Text="Rebase onto…" Click="Rebase_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Reset to selected commit">
                                <MenuFlyoutItem Text="Soft (keep changes staged)" Click="ResetSoft_Click" />
                                <MenuFlyoutItem Text="Mixed (keep changes unstaged)" Click="ResetMixed_Click" />
                                <MenuFlyoutItem Text="Hard (discard changes)" Click="ResetHard_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="In-progress operation">
                                <MenuFlyoutItem Text="Show conflicts" Click="ShowConflicts_Click" />
                                <MenuFlyoutItem Text="Rebase — continue" Click="RebaseContinue_Click" />
                                <MenuFlyoutItem Text="Rebase — skip" Click="RebaseSkip_Click" />
                                <MenuFlyoutItem Text="Rebase — abort" Click="RebaseAbort_Click" />
                                <MenuFlyoutItem Text="Merge — abort" Click="MergeAbort_Click" />
                                <!-- Cherry-pick and revert conflict just as readily as a rebase. -->
                                <MenuFlyoutItem Text="Cherry-pick — continue" Click="CherryPickContinue_Click" />
                                <MenuFlyoutItem Text="Cherry-pick — abort" Click="CherryPickAbort_Click" />
                                <MenuFlyoutItem Text="Revert — abort" Click="RevertAbort_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Bisect">
                                <MenuFlyoutItem Text="Start" Click="BisectStart_Click" />
                                <MenuFlyoutItem Text="Mark selected good" Click="BisectGood_Click" />
                                <MenuFlyoutItem Text="Mark selected bad" Click="BisectBad_Click" />
                                <MenuFlyoutItem Text="Reset" Click="BisectReset_Click" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="Repository…" Visibility="{x:Bind ViewModel.AdvancedVisibility, Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutSubItem Text="Tags">
                                <MenuFlyoutItem Text="Show tags" Click="ListTags_Click" />
                                <MenuFlyoutItem Text="Create tag at selected commit…" Click="CreateTag_Click" />
                                <MenuFlyoutItem Text="Delete tag…" Click="DeleteTag_Click" />
                                <MenuFlyoutItem Text="Push tag…" Click="PushTag_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Remotes">
                                <MenuFlyoutItem Text="Show remotes" Click="ListRemotes_Click" />
                                <MenuFlyoutItem Text="Add remote…" Click="AddRemote_Click" />
                                <MenuFlyoutItem Text="Remove remote…" Click="RemoveRemote_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Submodules">
                                <MenuFlyoutItem Text="Show submodules" Click="ListSubmodules_Click" />
                                <MenuFlyoutItem Text="Update (init, recursive)" Click="UpdateSubmodules_Click" />
                                <MenuFlyoutItem Text="Sync" Click="SyncSubmodules_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Worktrees">
                                <MenuFlyoutItem Text="Show worktrees" Click="ListWorktrees_Click" />
                                <MenuFlyoutItem Text="Add worktree…" Click="AddWorktree_Click" />
                                <MenuFlyoutItem Text="Remove worktree…" Click="RemoveWorktree_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Settings…" Click="Settings_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Advanced" VerticalAlignment="Center" />
                <ToggleSwitch OnContent="" OffContent="" MinWidth="0"
                              IsOn="{x:Bind ViewModel.IsAdvancedSelected, Mode=OneWay}"
                              Toggled="ModeToggle_Toggled" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="Open a repository to get started."
                   Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />

        <TabView Grid.Row="1" x:Name="RepositoryTabs"
                 TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                 IsAddTabButtonVisible="{x:Bind ViewModel.IsAddTabButtonVisible, Mode=OneWay}"
                 AddTabButtonClick="RepositoryTabs_AddTabButtonClick"
                 TabCloseRequested="RepositoryTabs_TabCloseRequested">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryTabViewModel">
                    <TabViewItem Header="{x:Bind Title}" IsClosable="True">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Padding="12,4,12,8"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ChromeVisibility, Mode=OneWay}">
                                <ComboBox ItemsSource="{x:Bind Branches}"
                                          SelectedItem="{x:Bind SelectedBranch, Mode=TwoWay}"
                                          PlaceholderText="{x:Bind Branch, Mode=OneWay}"
                                          MinWidth="180" />
                                <TextBox Text="{x:Bind Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Filter commits" MinWidth="200"
                                         Visibility="{x:Bind AdvancedVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind WorkingDir}" Opacity="0.55" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                              IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center"
                                           Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Padding="24,0,24,6"
                                  Visibility="{x:Bind ChromeVisibility, Mode=OneWay}">
                                <!-- Spacer matching the graph column so the headers line up with the rows. -->
                                <Border Width="{x:Bind GraphColumnWidth}" />
                                <TextBlock Grid.Column="1" Text="Hash" Width="92" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock Grid.Column="2" Text="Author" Width="170" FontWeight="SemiBold" Opacity="0.7"
                                           Visibility="{x:Bind SecondaryColumnVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="Subject" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock Grid.Column="4" Text="Date" Width="150" FontWeight="SemiBold" Opacity="0.7"
                                           Visibility="{x:Bind SecondaryColumnVisibility, Mode=OneWay}" />
                            </Grid>

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <ListView ItemsSource="{x:Bind Commits}"
                                          SelectedItem="{x:Bind SelectedCommit, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.Footer>
                                        <Button Content="Load more commits" Margin="24,8,0,12"
                                                Click="LoadMore_Click"
                                                Visibility="{x:Bind LoadMoreVisibility, Mode=OneWay}" />
                                    </ListView.Footer>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:CommitRowViewModel">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Height="{x:Bind RowHeight}">
                                                <!-- Lane drawing: one Path per colour, positioned in a Canvas
                                                     whose coordinate space matches RowHeight. -->
                                                <ItemsControl ItemsSource="{x:Bind GraphSegments}"
                                                              Width="{x:Bind GraphColumnWidth}"
                                                              VerticalAlignment="Stretch">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="graph:GraphSegment">
                                                            <Path Data="{x:Bind Geometry}" Stroke="{x:Bind Stroke}"
                                                                  Fill="{x:Bind Fill}" StrokeThickness="2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ShortHash}" Width="92"
                                                           VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.8" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Author}" Width="170"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Subject}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind Date}" Width="150"
                                                           VerticalAlignment="Center" Opacity="0.7" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Border Grid.Column="1" Width="360"
                                        BorderThickness="1,0,0,0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                                    <Grid RowDefinitions="Auto,Auto,*">
                                        <ScrollViewer Grid.Row="0" MaxHeight="260" Padding="16,16,16,8">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{x:Bind SelectedCommit.Subject, Mode=OneWay}"
                                                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SelectedCommit.FullHash, Mode=OneWay}"
                                                           FontFamily="Consolas" FontSize="12" Opacity="0.7"
                                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind SelectedCommit.Author, Mode=OneWay}" Opacity="0.85" />
                                                <TextBlock Text="{x:Bind SelectedCommit.AuthorEmail, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                                                <TextBlock Text="{x:Bind SelectedCommit.Date, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                                                <TextBlock Text="{x:Bind SelectedCommit.Body, Mode=OneWay}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </ScrollViewer>

                                        <TextBlock Grid.Row="1" Text="Changed files" Margin="16,8,16,4"
                                                   FontWeight="SemiBold" Opacity="0.7" />

                                                        <ListView Grid.Row="2" ItemsSource="{x:Bind ChangedFiles}"
                                                  SelectedItem="{x:Bind SelectedChangedFile, Mode=TwoWay}"
                                                  SelectionMode="Single" Padding="8,0,8,8">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:ChangedFileViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{x:Bind Change}" FontFamily="Consolas"
                                                                   Width="14" Opacity="0.7" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Detail}" FontSize="11" Opacity="0.55"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                                    Visibility="{x:Bind StagingVisibility}">
                                                            <Button Content="Stage" FontSize="11" Padding="6,2"
                                                                    Tag="{x:Bind Name}" Click="StageFile_Click" />
                                                            <Button Content="Unstage" FontSize="11" Padding="6,2"
                                                                    Tag="{x:Bind Name}" Click="UnstageFile_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Height="320" BorderThickness="0,1,0,0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind DiffVisibility, Mode=OneWay}">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10"
                                                Margin="24,8,24,6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DiffTitle, Mode=OneWay}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ToggleSwitch OnContent="Side by side" OffContent="Unified" MinWidth="0"
                                                      IsOn="{x:Bind IsSideBySide, Mode=TwoWay}" />
                                        <Button Content="Blame" FontSize="12" Padding="8,2" Click="Blame_Click" />
                                        <Button Content="File history" FontSize="12" Padding="8,2" Click="FileHistory_Click" />
                                    </StackPanel>

                                    <!-- Unified -->
                                    <ListView Grid.Row="1" ItemsSource="{x:Bind DiffLines}"
                                              SelectionMode="None" Padding="16,0,16,8"
                                              Visibility="{x:Bind UnifiedVisibility, Mode=OneWay}"
                                              ScrollViewer.HorizontalScrollMode="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:DiffLineViewModel">
                                                <Grid ColumnDefinitions="40,40,*" Background="{x:Bind Background}">
                                                    <TextBlock Text="{x:Bind OldLineNumber}" FontFamily="Consolas"
                                                               FontSize="11" Opacity="0.45" TextAlignment="Right"
                                                               Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind NewLineNumber}" FontFamily="Consolas"
                                                               FontSize="11" Opacity="0.45" TextAlignment="Right"
                                                               Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="2" controls:DiffTextBehavior.Line="{x:Bind}"
                                                               FontFamily="Consolas" FontSize="12"
                                                               IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Side by side -->
                                    <ListView Grid.Row="1" ItemsSource="{x:Bind SideBySideLines}"
                                              SelectionMode="None" Padding="16,0,16,8"
                                              Visibility="{x:Bind SideBySideVisibility, Mode=OneWay}"
                                              ScrollViewer.HorizontalScrollMode="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="diff:SideBySideRow">
                                                <Grid ColumnDefinitions="*,1,*" ColumnSpacing="6">
                                                    <Grid ColumnDefinitions="40,*" Background="{x:Bind Left.Background}">
                                                        <TextBlock Text="{x:Bind Left.OldLineNumber}" FontFamily="Consolas"
                                                                   FontSize="11" Opacity="0.45" TextAlignment="Right"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" controls:DiffTextBehavior.Line="{x:Bind Left}"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   IsTextSelectionEnabled="True" />
                                                    </Grid>
                                                    <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                                    <Grid Grid.Column="2" ColumnDefinitions="40,*" Background="{x:Bind Right.Background}">
                                                        <TextBlock Text="{x:Bind Right.NewLineNumber}" FontFamily="Consolas"
                                                                   FontSize="11" Opacity="0.45" TextAlignment="Right"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" controls:DiffTextBehavior.Line="{x:Bind Right}"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   IsTextSelectionEnabled="True" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
    </Grid>
</Window>
